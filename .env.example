# Public base URL of the Cloudflare R2 bucket that holds beat audio + peaks (keys: media/beat-<id>/audio.mp3, peaks.json).
# Unset in local dev = served from public/media/ if you have the files locally.
NEXT_PUBLIC_MEDIA_BASE=https://media.flavorfulmusic.com
NEXT_PUBLIC_SITE_URL=https://flavorfulmusic.com
# Only if the site is ever served from a sub-path instead of the custom domain (e.g. /flavorful-music-site).
NEXT_PUBLIC_BASE_PATH=
# Checkout switch. Anything but 1 = every buy button reads "Coming soon" and nothing links to Payhip/Ko-fi.
# Turn on only after payouts are connected and the Payhip products are visible; re-export content with
# `export-content.py --payhip` first so beats.json carries each beat's payhipUrl.
NEXT_PUBLIC_CHECKOUT_LIVE=0
# Analytics (off by default): plausible | umami
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_UMAMI_ID=
# Customer accounts (optional; guest checkout never needs one). Base URL of the accounts API, e.g. /api/account when the accounts
# Worker serves the site. Unset = accounts off: no Sign in link, account pages say accounts aren't open.
NEXT_PUBLIC_ACCOUNTS_API=
# Public merch filter (content/catalog-published.json). 1 = build only the published merch and prune other merch images from out/.
# Off by default so the live shop doesn't change until it's signed off.
MERCH_PUBLIC_SET=0
